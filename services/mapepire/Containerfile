# Mapepire Python Client — container image
#
# Connects to a mapepire-server RPM already running on IBM i (port 8076 by
# default).  All IBM i credentials are supplied at runtime via env vars; they
# are never baked into the image.
#
# ── Authentication modes ─────────────────────────────────────────────────────
#
#  Mode A — SSH key (recommended, no IBM i password needed):
#    Mount the private key into the container and set IBMI_SSH_KEY_PATH.
#    The connector opens an SSH tunnel (localhost:<IBMI_TUNNEL_LOCAL_PORT>)
#    and mapepire-python connects through it.
#
#    podman run --rm \
#      -e IBMI_HOST=my.ibmi.host \
#      -e IBMI_USER=MYUSER \
#      -e IBMI_SSH_KEY_PATH=/run/secrets/ibmi_key \
#      -v ~/.ssh/id_rsa:/run/secrets/ibmi_key:ro,Z \
#      mapepire-client:latest
#
#  Mode B — password (original behaviour):
#    podman run --rm \
#      -e IBMI_HOST=my.ibmi.host \
#      -e IBMI_USER=MYUSER \
#      -e IBMI_PASSWORD=secret \
#      mapepire-client:latest
#
# Build (x86_64 / aarch64 / ppc64le):
#   podman build -t mapepire-client:latest -f Containerfile .

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# ----- Environment -------------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH

# ----- OS dependencies + Python environment (single layer) ---------------
#
# Runtime packages kept in the final image:
#   openssh-clients  — ssh binary (sshtunnel transport fallback)
#   shadow-utils     — non-root user creation
#
# Build-time packages removed in the same layer:
#   gcc / make / python3.11-devel / libffi-devel / openssl-devel
#       — C toolchain needed to compile bcrypt, pynacl (Rust-backed extensions)
#         that have no pre-built ppc64le wheels on PyPI
#         (transitive deps: sshtunnel → paramiko → bcrypt / pynacl)
#   Rust toolchain    — installed via rustup into /tmp, deleted after pip install
#
# NOTE: UBI minimal ships curl-minimal; installing the full 'curl' package
# conflicts with it.  We use the pre-installed curl-minimal (available as
# /usr/bin/curl) to download rustup — no extra curl install needed.
#
# Everything is done in one RUN so that build tools never appear in any
# committed image layer, keeping the final image as small as possible.
RUN microdnf install -y \
        python3.11 \
        python3.11-pip \
        python3.11-devel \
        openssh-clients \
        shadow-utils \
        gcc \
        make \
        libffi-devel \
        openssl-devel \
    && python3.11 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && export RUSTUP_HOME=/tmp/rustup \
              CARGO_HOME=/tmp/cargo \
              PATH="/tmp/cargo/bin:$PATH" \
    && curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
         --default-toolchain stable --profile minimal \
    && /opt/venv/bin/pip install --no-cache-dir \
        "mapepire-python>=0.2.0" \
        "python-dotenv>=1.0.0" \
        "sshtunnel>=0.4.0" \
    && rm -rf /tmp/rustup /tmp/cargo /root/.cargo \
    && microdnf remove -y \
        gcc \
        make \
        python3.11-devel \
        libffi-devel \
        openssl-devel \
    && microdnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf /root/.cache

# ----- Non-root user ------------------------------------------------------
RUN useradd -r -u 1001 -g 0 -s /sbin/nologin appuser

# ----- Application code ---------------------------------------------------
WORKDIR /app
COPY mapepire_connector.py example_query.py entrypoint.sh ./

RUN chown -R 1001:0 /app && chmod -R g=u /app \
    && chmod +x /app/entrypoint.sh

# Container starts as root so the entrypoint can copy and chown the mounted
# SSH key (which is typically root:root 600 on the host) to a temp path
# readable by UID 1001, then drops privileges via runuser before exec-ing.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "example_query.py"]
