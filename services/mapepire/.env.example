# .env.example — mapepire Python client container
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── Always required ───────────────────────────────────────────────────────────

# IBM i hostname or IP address where mapepire-server RPM is running
IBMI_HOST=my.ibmi.host

# IBM i user profile
IBMI_USER=MYUSER

# IBM i password — ALWAYS required.
# mapepire-server passes this directly to IBM i Db2 SQL for authentication.
# An SSH key (below) secures the network path but does NOT replace this.
IBMI_PASSWORD=changeme

# ── Optional: SSH tunnel (recommended for secure deployments) ─────────────────

# Path *inside the container* where the SSH private key is mounted.
# When set, the connector opens an SSH tunnel before connecting to mapepire.
# Mount it at runtime: -v ~/.ssh/id_rsa:/run/secrets/ibmi_key:ro,Z
# IBMI_SSH_KEY_PATH=/run/secrets/ibmi_key

# If the private key file is passphrase-protected, set this:
# IBMI_SSH_KEY_PASSPHRASE=

# ── Optional (mapepire-server) ────────────────────────────────────────────────

# TCP port mapepire-server listens on (default: 8076)
# IBMI_PORT=8076

# Set to "true" to skip TLS certificate verification (self-signed certs / dev)
# IBMI_IGNORE_TLS=false

# ── Optional (SSH tunnel — Mode A only) ───────────────────────────────────────

# IBM i sshd port (default: 22)
# IBMI_SSH_PORT=22

# Local port the SSH tunnel will bind on inside the container (default: 18076)
# Change only if 18076 is already in use.
# IBMI_TUNNEL_LOCAL_PORT=18076

# ── Optional (smoke-test script) ─────────────────────────────────────────────

# IBM i library (schema) to list tables from in example_query.py
# IBMI_TEST_SCHEMA=QIWS

# Table to describe in example_query.py (must exist in IBMI_TEST_SCHEMA)
# IBMI_TEST_TABLE=QCUSTCDT

# Free-form SQL to execute in step 4 of example_query.py
# IBMI_TEST_SQL=SELECT * FROM QIWS.QCUSTCDT FETCH FIRST 5 ROWS ONLY

# ── Optional (logging) ────────────────────────────────────────────────────────

# Python logging level for the container process (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
